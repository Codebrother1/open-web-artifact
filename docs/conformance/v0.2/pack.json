    {
      "id": "pack-unicode-no-normalization",
      "description": "Filenames that look alike but are distinct code-point sequences and are NOT canonically equivalent (so they coexist on Linux, macOS and Windows): ASCII digits/letters versus superscript two (U+00B2), the fi ligature (U+FB01) and fullwidth f (U+FF46), plus 10 versus 9 versus 2. packDirectory must compare the exact strings by code point: no Unicode normalization (compatibility folding would merge them), no case folding, no natural/numeric ordering (\"10\" sorts before \"2\" and \"9\").",
      "input": {
        "files": [
          {
            "path": "ｆ.txt",
            "contentBase64": "ZnVsbHdpZHRoIGYgVStGRjQ2Cg=="
          },
          {
            "path": "9.txt",
            "contentBase64": "bmluZQo="
          },
          {
            "path": "fi.txt",
            "contentBase64": "ZiBpCg=="
          },
          {
            "path": "².txt",
            "contentBase64": "c3VwZXJzY3JpcHQgdHdvIFUrMDBCMgo="
          },
          {
            "path": "index.html",
            "contentBase64": "PCFkb2N0eXBlIGh0bWw+PHRpdGxlPm5vIG5vcm1hbGl6YXRpb248L3RpdGxlPgo="
          },
          {
            "path": "10.txt",
            "contentBase64": "dGVuCg=="
          },
          {
            "path": "ﬁ.txt",
            "contentBase64": "ZmkgbGlnYXR1cmUgVStGQjAxCg=="
          },
          {
            "path": "2.txt",
            "contentBase64": "dHdvCg=="
          },
          {
            "path": "f.txt",
            "contentBase64": "Zgo="
          }
        ],
        "symlinks": [],
        "entrypoint": "/index.html"
