      "expected": {
        "canonicalJson": "{\"artifactType\":\"application/vnd.openwebartifact.site.v1+json\",\"entrypoint\":\"/index.html\",\"files\":[{\"digest\":\"sha256:ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad\",\"mediaType\":\"text/html; charset=utf-8\",\"path\":\"/index.html\",\"size\":3}],\"specVersion\":\"owa.dev/v1\"}",
