        "canonicalJson": "0.1",
        "digest": "sha256:14be4b45f18e0d8c67b4f719b5144eee88497e413709d11d85b096d8e2346310"
      }
    },
    {
      "id": "canonical-true",
      "description": "Exact reference binary64/JSON serialization; no additional whitespace or newline.",
      "inputJson": "true",
      "expected": {
        "canonicalJson": "true",
        "digest": "sha256:b5bea41b6c623f7c09f1bf24dcae58ebab3c0cdd90ad966bc43a45b44867e12b"
      }
    },
    {
      "id": "canonical-false",
      "description": "Exact reference binary64/JSON serialization; no additional whitespace or newline.",
      "inputJson": "false",
