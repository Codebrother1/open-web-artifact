    },
    {
      "id": "canonical-positive-overflow",
      "description": "Syntactically valid JSON number overflows binary64; canonicalization rejects the resulting non-finite value.",
      "inputJson": "1e400",
      "expected": {
        "errorCategory": "OWA_INVALID_JSON_VALUE"
      }
    },
    {
      "id": "canonical-negative-overflow",
      "description": "Syntactically valid JSON number overflows binary64; canonicalization rejects the resulting non-finite value.",
      "inputJson": "-1e400",
