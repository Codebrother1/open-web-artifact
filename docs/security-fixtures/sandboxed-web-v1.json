  ],
  "pathCases": [
    { "id": "root", "rawPath": "/", "resolvedPath": "/index.html" },
    { "id": "asset", "rawPath": "/assets/x.js", "resolvedPath": "/assets/x.js" },
    { "id": "repeated-slashes", "rawPath": "///assets//x.js", "resolvedPath": "/assets/x.js" },
    { "id": "dot-segments", "rawPath": "/./assets/./x.js", "resolvedPath": "/assets/x.js" },
    { "id": "encoded-dot", "rawPath": "/assets/%2e/x.js", "resolvedPath": "/assets/x.js" },
    { "id": "encoded-slash", "rawPath": "/assets%2fx.js", "resolvedPath": "/assets/x.js" },
    { "id": "trailing-dot", "rawPath": "/assets/x.js/.", "resolvedPath": "/assets/x.js" },
    { "id": "trailing-slash", "rawPath": "/assets/x.js/", "resolvedPath": null, "unsafe": false },
