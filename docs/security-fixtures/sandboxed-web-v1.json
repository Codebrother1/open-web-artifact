    { "path": "/%2e%2e/secret", "text": "literal percent-looking dot-dot namespace\n", "mediaType": "text/plain" },
    { "path": "/a%2fb", "text": "literal percent-looking slash namespace\n", "mediaType": "text/plain" },
    { "path": "/%FF", "text": "literal percent-looking invalid UTF-8 namespace\n", "mediaType": "text/plain" },
