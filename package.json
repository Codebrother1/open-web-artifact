{
  "name": "open-web-artifact",
  "version": "0.4.0",
  "private": true,
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/conformance/src/*.test.js",
    "test:conformance": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/conformance/src/fixtures.test.js packages/conformance/src/schema.test.js",
    "test:property": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/conformance/src/property.test.js",
    "test:security": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/conformance/src/security-*.test.js",
    "test:integration": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/integration/src/*.test.js",
    "test:integration:harness": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/integration/checks/*.test.js",
    "test:oci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/integration/oci/*.test.js",
    "test:mcp": "npm --prefix packages/mcp test",
    "test:gc": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/gc/test/*.test.js",
    "test:integrity": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/conformance/src/security-integrity.test.js",
    "test:browser": "npm --prefix packages/browser-tests test",
    "test:go-conformance": "go -C implementations/go-conformance test ./... -count=1",
    "start": "node packages/server/src/index.js",
    "dev:server": "node packages/server/src/index.js --dev",
    "test:auth": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./.github/scripts/test-summary-reporter.mjs --test-reporter-destination=stdout packages/conformance/src/auth-*.test.js",
    "artifact": "node packages/cli/src/index.js",
    "gc": "node packages/gc/src/cli.js"
  }
}
