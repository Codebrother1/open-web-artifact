{
  "name": "open-web-artifact",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test packages/conformance/src/*.test.js",
    "test:conformance": "node --test packages/conformance/src/fixtures.test.js packages/conformance/src/schema.test.js",
    "test:property": "node --test packages/conformance/src/property.test.js",
    "test:security": "node --test packages/conformance/src/security-*.test.js",
    "test:integration": "node --test packages/integration/src/*.test.js",
    "test:integration:harness": "node --test packages/integration/checks/*.test.js",
    "test:mcp": "npm --prefix packages/mcp test",
    "test:gc": "node --test packages/gc/test/*.test.js",
    "test:integrity": "node --test packages/conformance/src/security-integrity.test.js",
    "test:browser": "npm --prefix packages/browser-tests test",
    "start": "node packages/server/src/index.js",
    "dev:server": "node packages/server/src/index.js --dev",
    "test:auth": "node --test packages/conformance/src/auth-*.test.js",
    "artifact": "node packages/cli/src/index.js",
    "gc": "node packages/gc/src/cli.js"
  }
}
