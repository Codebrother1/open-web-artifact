{
  "tools": [
    {
      "name": "publish",
      "description": "Pack a directory under the operator staging root and publish using HTTP plan/upload/commit. Activates by default; false stages a release. Requires a trusted, read-only staging tree during packing; not a filesystem sandbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}(?![\\s\\S])"
          },
          "server": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "The configured trusted HTTP(S) origin; no path, query, credentials, or fragment."
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?:(?=[A-Za-z]:[\\\\/])|(?![A-Za-z][A-Za-z0-9+.-]*:))[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
            "description": "Existing directory, relative to the configured root or absolute inside it. No URL or control characters."
          },
          "activate": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "site",
          "server",
          "directory"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": true
              },
              "site": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63,
                "pattern": "^[a-z0-9][a-z0-9_-]{0,62}(?![\\s\\S])"
              },
              "artifactDigest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
              },
              "releaseId": {
                "type": "string",
                "pattern": "^r_[0-9a-f]{20}(?![\\s\\S])"
              },
              "activeReleaseId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^r_[0-9a-f]{20}(?![\\s\\S])"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "uploaded": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reused": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "url": {
                "type": "string",
                "description": "Public gateway URL, not an upload grant or a claim of origin isolation."
              }
            },
            "required": [
              "ok",
              "site",
              "artifactDigest",
              "releaseId",
              "activeReleaseId",
              "uploaded",
              "reused",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "ok": {
                "const": false
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "enum": [
                      "OWA_MCP_CONFIG",
                      "OWA_MCP_INVALID_INPUT",
                      "OWA_MCP_INVALID_RESPONSE",
                      "OWA_MCP_CONTROL_FAILED",
                      "OWA_MCP_UPLOAD_FAILED",
                      "OWA_MCP_NETWORK_FAILED",
                      "OWA_MCP_FAILED",
                      "OWA_AUTH_CONFIG",
                      "OWA_AUTH_INVALID_TOKEN",
                      "OWA_AUTH_INVALID_SIGNATURE",
                      "OWA_AUTH_EXPIRED",
                      "OWA_AUTH_MISSING",
                      "OWA_AUTH_SITE",
                      "OWA_AUTH_CAPABILITY",
                      "OWA_AUTH_DEV_ONLY"
                    ]
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "configuration",
                      "invalid_input",
                      "invalid_response",
                      "control_plane",
                      "upload",
                      "network",
                      "internal",
                      "authentication",
                      "site_scope",
                      "capability"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "enum": [
                      "Invalid adapter configuration",
                      "Invalid input",
                      "Invalid control-plane response",
                      "Control-plane request failed",
                      "Blob upload failed",
                      "Network request failed",
                      "Operation failed",
                      "Invalid authentication configuration",
                      "Invalid authentication token",
                      "Invalid authentication signature",
                      "Authentication token expired",
                      "Authentication required",
                      "Authentication does not permit this site",
                      "Authentication does not permit this operation",
                      "Development authentication requires a direct loopback connection"
                    ]
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  }
                },
                "required": [
                  "code",
                  "category",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ok",
              "error"
            ],
            "additionalProperties": false
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "list_releases",
      "description": "List validated release metadata and the active pointer over HTTP. Requires read capability. Does not return manifests or file bytes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "site": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
